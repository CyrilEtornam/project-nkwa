            "apiKeyHeader": []
        },
        {
            "apiKeyQuery": []
        }
    ],
    "tags": [
        {
            "name": "Languages & Speakers",
            "description": "Discover supported languages and available voices."
        },
        {
            "name": "Synthesis",
            "description": "Convert text into spoken audio."
        }
    ]
}